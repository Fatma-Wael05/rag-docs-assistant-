# Copy this file to .env and adjust as needed.

# Path to the persisted vector store (relative to where you run uvicorn from)
VECTOR_STORE_DIR=data/vector_store
CHROMA_COLLECTION_NAME=rag_docs

# Must match the embedding model used in notebooks/rag_pipeline.ipynb
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Local Ollama model to use for generation
OLLAMA_MODEL=llama3.1

# Number of chunks to retrieve per query
RETRIEVAL_TOP_K=4

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:8501
